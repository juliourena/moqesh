# Copia a .env y ajusta. Todas las variables llevan prefijo MOQESH_.

# Almacenamiento
MOQESH_DB_PATH=moqesh.db
# MOQESH_WEB_DIST=web/dist          # ruta al build del frontend (auto si está junto al paquete)

# Puertos
MOQESH_HONEYPOT_PORT=8080
MOQESH_DASHBOARD_PORT=5000

# URL pública del servidor Moqesh (a la que se conectan los sensores remotos)
# MOQESH_PUBLIC_URL=https://moqesh.example.com

# Generación de contenido
# MOQESH_SEED=                      # vacío = se genera un seed por deployment (anti-fingerprint)
MOQESH_GENERATION_MODE=Template     # Template | Mimic | Static
# MOQESH_TARGET_URL=https://ejemplo.com   # solo Mimic
# Perfil de sitio built-in (saas|corp|ecommerce|nonprofit): taxonomía de rutas, vocabulario y
# colecciones de API realistas sin crawlear. Vacío = laberinto genérico por seed. Más perfiles:
# scripts/build_profile.py crawlea un sitio autorizado y genera moqesh/profiles/<nombre>.json.
# MOQESH_SITE_PROFILE=saas
MOQESH_REALISM_LEVEL=3              # 1..5

# World: contenido estático INERTE multi-sitio (fuente primaria; sustituye al laberinto generado).
# El honeypot sirve ficheros reales de un árbol en disco; SOLO bytes, nunca ejecuta nada. Con un
# World activo el laberinto queda OFF (era la fuente de los delatores de contenido autogenerado).
MOQESH_WORLD_ENABLED=true
# MOQESH_WORLD_PATH=                # vacío = junto a la DB (<dir de la DB>/world)
MOQESH_WORLD_AUTOSEED=true          # si el World está vacío, copia la semilla curada empaquetada
# MOQESH_VOCABULARY_THEME=          # corporate|devops|saas|ecommerce ("" = por seed)
MOQESH_TARPIT_DELAY_MS=0            # retardo fijo base por respuesta (ms)

# Tarpit adaptativo: el laberinto es coherente y finito por defecto (indetectable); solo cuando
# una sesión se confirma agente hostil (score alto) sube la intensidad -> prosa/logs más largos y
# un retardo creciente que quema tokens/wall-clock del agente. Invisible a tráfico humano.
MOQESH_ADAPTIVE_TARPIT=true
MOQESH_TARPIT_MAX_MS=6000          # retardo máximo por respuesta a intensidad 3 (agente confirmado)
# Opt-in de "quema bruta": a intensidad máxima la API vuelve a paginar sin fin (rompe el sigilo,
# vuelve a ser fingerprinteable). OFF por defecto = se mantiene el invariante de coherencia.
MOQESH_ALLOW_INFINITE_ON_CONFIRMED=false
# Escenario CTF (corp-breach): false = solo laberinto realista (máximo sigilo, no delata el
# patrón de honeypot); true = cebo activo (cadena de migajas + gate de reuso de credencial).
MOQESH_SCENARIOS_ENABLED=false

# Detección / alertas
MOQESH_ALERT_SCORE_THRESHOLD=0.5
MOQESH_ALERT_MIN_REQUESTS=5

# Bloqueo / notificaciones
MOQESH_ENFORCE_BLOCK=true
MOQESH_AUTO_BLOCK_SCORE=0.0        # 0 = auto-bloqueo por score desactivado (credential_reuse siempre bloquea)
# MOQESH_WEBHOOK_URL=
# MOQESH_WEBHOOK_SECRET=
MOQESH_ENABLE_IPTABLES=false

# Autenticación del dashboard (admin único)
MOQESH_ADMIN_USER=admin
# MOQESH_ADMIN_PASSWORD=            # vacío = se genera una y se imprime en el log (una sola vez)
# MOQESH_SESSION_SECRET=           # vacío = se genera y persiste junto a la DB (estable por despliegue)
MOQESH_SESSION_MAX_AGE=86400       # vida de la sesión en segundos
MOQESH_COOKIE_SECURE=false         # true tras TLS (subdominio admin); false en local/túnel http

# Confirmación con IA (opcional; el sistema funciona sin ella)
MOQESH_AI_ENABLED=false
MOQESH_AI_PROVIDER=heuristic        # heuristic | openai
# MOQESH_AI_BASE_URL=https://openrouter.ai/api/v1
# MOQESH_AI_API_KEY=
# MOQESH_AI_MODEL=anthropic/claude-haiku-5.5

# Worldsmith: agente IA que construye/evoluciona el World + el cebo (bajo demanda).
# `python -m moqesh.worldsmith build|evolve`. Guía: docs/WORLDSMITH.md
MOQESH_WORLDSMITH_PROVIDER=stub     # stub (sin IA) | api (Anthropic) | claude_cli (suscripción)
# MOQESH_WORLDSMITH_MODEL=claude-sonnet-4-5
# MOQESH_WORLDSMITH_API_KEY=        # provider=api; si vacío, cae a MOQESH_AI_API_KEY
# MOQESH_WORLDSMITH_BASE_URL=https://api.anthropic.com
MOQESH_WORLDSMITH_PORTALS=4
# MOQESH_WORLDSMITH_BRAND=
# Para claude_cli: export CLAUDE_CODE_OAUTH_TOKEN=$(claude setup-token)
